NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://personalos:personalos_dev@127.0.0.1:55433/personalos?schema=public
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18790
# File containing OPENCLAW_GATEWAY_TOKEN=... (bootstrap credential for first pairing)
OPENCLAW_GATEWAY_TOKEN_FILE=../../infra/openclaw/.env
OPENCLAW_AGENT_ID=personalos
# Directory (0700) holding the API's Ed25519 device identity and issued device token
OPENCLAW_DEVICE_DIR=../../.secrets/api-device

# Azure Speech (Phase 2 voice). Use an S0 resource; F0 rate-limits after ~10 requests/min.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# Integration credential vault: AES-256-GCM key, base64 of 32 random bytes (openssl rand -base64 32)
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_KEY_VERSION=1
# Microsoft 365 calendar (Entra app registration, delegated Calendars.Read)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3000/api/integrations/microsoft-calendar/callback
