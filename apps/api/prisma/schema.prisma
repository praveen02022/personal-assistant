// PersonalOS application schema (Phase 1).
// OpenClaw owns transcripts and agent state; this database owns users, auth sessions,
// conversation references, task lifecycle, and audit metadata. No message bodies here.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  displayName  String
  passwordHash String // argon2id (PHC string: algorithm, params, salt, hash)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  preference      UserPreference?
  voicePreference VoicePreference?
  integrations    IntegrationConnection[]
  oauthStates     OAuthState[]
  agentTokens     AgentAccessToken[]
  authSessions    AuthSession[]
  conversations   Conversation[]
  tasks           AppTask[]
  auditLogs       AuditLog[]
}

/// Server-side session. The cookie holds an opaque random token; only its SHA-256 is stored.
model AuthSession {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserPreference {
  userId        String   @id @db.Uuid
  language      String   @default("en-IN")
  timezone      String   @default("Asia/Kolkata")
  assistantName String   @default("Assistant")
  configuration Json     @default("{}")
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Voice settings. Provider ids select an implementation behind the provider-neutral interfaces.
model VoicePreference {
  userId      String   @id @db.Uuid
  /// "auto" = choose between en-IN and ta-IN; or a fixed locale.
  language    String   @default("auto")
  sttProvider String   @default("azure")
  ttsProvider String   @default("azure")
  voiceEn     String   @default("en-IN-NeerjaNeural")
  voiceTa     String   @default("ta-IN-PallaviNeural")
  speechRate  Float    @default(1.0)
  /// Speak the answer automatically when the turn started by voice.
  autoSpeak   Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum IntegrationStatus {
  CONNECTED
  NEEDS_RECONNECT
}

/// A user's link to an external account. Never holds secrets: see credentialId.
model IntegrationConnection {
  id            String            @id @default(uuid(7)) @db.Uuid
  userId        String            @db.Uuid
  /// e.g. "microsoft-calendar"
  provider      String
  status        IntegrationStatus
  /// Account the user signed in with (shown in the UI).
  accountEmail  String?
  /// Scopes the provider actually granted (verified at connect time).
  grantedScopes String[]
  /// Encrypted credential record (refresh token). Unique: one credential per connection.
  credentialId  String            @unique @db.Uuid
  lastUsedAt    DateTime?
  lastError     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential IntegrationCredential @relation(fields: [credentialId], references: [id])

  @@unique([userId, provider])
}

/// AES-256-GCM ciphertext of provider tokens. Kept apart so ordinary queries never load it;
/// keyVersion allows key rotation (or moving to a KMS-backed store) without schema changes.
model IntegrationCredential {
  id         String   @id @default(uuid(7)) @db.Uuid
  keyVersion Int
  iv         Bytes
  authTag    Bytes
  ciphertext Bytes
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  connection IntegrationConnection?
}

/// One-time OAuth state (CSRF + PKCE). Consumed atomically by the callback; expires in minutes.
model OAuthState {
  stateHash             String   @id
  userId                String   @db.Uuid
  provider              String
  /// PKCE code_verifier, encrypted with the credential vault.
  codeVerifierEncrypted String
  expiresAt             DateTime
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Credential an agent runtime (one OpenClaw Gateway) uses to call PersonalOS tools.
/// Only the SHA-256 is stored; scopes bound what it can call; revocable.
model AgentAccessToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  name       String
  tokenHash  String    @unique
  scopes     String[]
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Reference to an OpenClaw session. The transcript lives in OpenClaw (chat.history).
model Conversation {
  id                 String    @id @default(uuid(7)) @db.Uuid
  userId             String    @db.Uuid
  /// Server-generated: agent:personalos:personalos:<conversationId>. Never client-supplied.
  openClawSessionKey String    @unique
  title              String?
  lastMessageAt      DateTime?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks AppTask[]

  @@index([userId, lastMessageAt(sort: Desc)])
}

enum TaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

/// One user request and its agent run(s). id doubles as the OpenClaw idempotencyKey.
model AppTask {
  id              String     @id @default(uuid(7)) @db.Uuid
  userId          String     @db.Uuid
  conversationId  String     @db.Uuid
  /// Client-generated id; (userId, clientRequestId) dedupes double submits.
  clientRequestId String     @db.Uuid
  /// First OpenClaw runId. Restart recovery can add more (see runIds).
  openClawRunId   String?    @unique
  /// Every runId that has served this task, including restart-recovery runs.
  runIds          String[]   @default([])
  taskType        String     @default("chat")
  status          TaskStatus @default(QUEUED)
  errorCode       String?
  cancelRequested Boolean    @default(false)
  metadata        Json       @default("{}")
  lastEventAt     DateTime?
  createdAt       DateTime   @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, clientRequestId])
  @@index([conversationId, createdAt])
  @@index([status, createdAt])
}

/// Metadata-only audit trail: never prompts, tokens, or tool payloads.
model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String?  @db.Uuid
  action        String
  resourceType  String
  resourceId    String?
  correlationId String?
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([correlationId])
}
